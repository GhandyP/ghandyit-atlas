---
import Base from '../layouts/Base.astro';
import Sidebar from '../components/Sidebar.astro';
import CatalogQuality from '../components/CatalogQuality.astro';
import OndoTable from '../components/OndoTable.astro';
import AnalyticsDashboard from '../components/AnalyticsDashboard.astro';
import { ondoAssets, ondoCatalogQuality, ondoStats } from '../data/ondoAssets';
import { ondoAnalytics } from '../data/ondoAnalytics';
import { buildClassificationView } from '../data/analytics/classifications';
import { readReleaseHealth } from '../data/analytics/releaseHealth.mjs';

const releaseHealth = readReleaseHealth();

const compactMoney = new Intl.NumberFormat('en-US', {
  style: 'currency',
  currency: 'USD',
  notation: 'compact',
  compactDisplay: 'short',
  maximumFractionDigits: 1,
});

const compactNumber = new Intl.NumberFormat('en-US', {
  notation: 'compact',
  compactDisplay: 'short',
  maximumFractionDigits: 1,
});

const topMarketCapLabel = ondoStats.topMarketCapAsset
  ? `${ondoStats.topMarketCapAsset.symbol} · ${ondoStats.topMarketCapAsset.tokenName}`
  : 'N/D';

const pageSummary = {
  assetCount: ondoStats.count,
  totalMarketCap: ondoStats.totalMarketCap,
  totalHolders: ondoStats.totalHolders,
  zeroMarketCapCount: ondoStats.zeroMarketCapCount,
};

const analyticsView = buildClassificationView(ondoAnalytics.assets as Array<{ classification?: { assetType?: string; sector?: string; geography?: string } }>);
---

<Base title="Ghandyit · Ondo tokenized assets">
  <div class="app-shell">
    <Sidebar
      assetCount={pageSummary.assetCount}
      totalMarketCap={compactMoney.format(pageSummary.totalMarketCap)}
      topMarketCapLabel={topMarketCapLabel}
      totalHolders={compactNumber.format(pageSummary.totalHolders)}
      zeroMarketCapCount={pageSummary.zeroMarketCapCount}
    />

    <CatalogQuality catalog={ondoCatalogQuality} analytics={ondoAnalytics} health={releaseHealth} />

    <AnalyticsDashboard
      groups={analyticsView.groups}
      activeDimension={analyticsView.activeDimension}
      dimensionOptions={analyticsView.dimensionOptions}
      mode={ondoAnalytics.mode}
      quality={ondoAnalytics.quality}
    />

    <OndoTable assets={ondoAssets} />
  </div>
</Base>
