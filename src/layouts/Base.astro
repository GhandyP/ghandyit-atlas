---
interface Props {
  title?: string;
}

const { title = 'Ghandyit · Ondo tokenized assets' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Saltar al contenido principal</a>
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --bg: #07111f;
    --surface: #0c1729;
    --surface-soft: #11213a;
    --border: #1c3353;
    --text: #fdfdfb;
    --muted: #b2c4dd;
    --accent: #38bdf8;
    --accent-soft: rgba(56, 189, 248, 0.12);
    --success: #14b8a6;
    --success-soft: rgba(20, 184, 166, 0.12);
    --warning: #f59e0b;
    --warning-soft: rgba(245, 158, 11, 0.10);
    --danger: #ef4444;
    --danger-soft: rgba(239, 68, 68, 0.10);
    --shadow: 0 14px 36px rgba(0, 0, 0, 0.38);
    --shadow-soft: 0 8px 20px rgba(0, 0, 0, 0.24);
    --radius-xl: 24px;
    --radius-lg: 18px;
    --radius-md: 14px;
    --radius-sm: 10px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    font-family: 'IBM Plex Sans', sans-serif;
    color: var(--text);
    background:
      radial-gradient(circle at top left, rgba(56, 189, 248, 0.16), transparent 25%),
      radial-gradient(circle at top right, rgba(20, 184, 166, 0.10), transparent 18%),
      var(--bg);
    min-height: 100vh;
  }

  h1,
  h2,
  h3,
  h4 {
    margin: 0;
    font-family: 'IBM Plex Sans', sans-serif;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  p {
    margin: 0;
  }

  button,
  input,
  select {
    font: inherit;
  }

  code,
  pre {
    font-family: 'IBM Plex Mono', monospace;
  }

  button {
    cursor: pointer;
  }

  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .skip-link:focus-visible {
    position: fixed;
    inset: 12px auto auto 12px;
    width: auto;
    height: auto;
    padding: 10px 14px;
    z-index: 100;
    background: var(--surface);
    color: var(--text);
    border: 2px solid var(--accent);
    border-radius: var(--radius-sm);
    font-weight: 700;
    clip: auto;
    clip-path: none;
  }

  .app-shell {
    width: min(1520px, calc(100% - 32px));
    margin: 0 auto;
    padding: 24px 0 44px;
    display: grid;
    gap: 16px;
  }

  .hero,
  .controls,
  .table-panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.22);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(320px, 0.95fr);
    gap: 20px;
    padding: 22px;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg, var(--accent), #9867e3);
  }

  .hero-copy {
    display: grid;
    gap: 12px;
    align-content: start;
  }

  .brand-lockup {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .brand-logo {
    width: 58px;
    height: 58px;
    object-fit: contain;
    flex: 0 0 auto;
    filter: drop-shadow(0 8px 20px rgba(0, 0, 0, 0.38));
  }

  .brand-line {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--muted);
    font-size: 0.84rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 700;
  }

  .brand-line strong {
    color: var(--accent);
    letter-spacing: 0.14em;
  }

  .brand-line span {
    width: 38px;
    height: 1px;
    background: linear-gradient(90deg, var(--accent), transparent);
  }

  .eyebrow {
    font-size: 0.74rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accent);
  }

  .hero-copy h1 {
    font-size: clamp(2.1rem, 4vw, 3.8rem);
    line-height: 0.96;
    max-width: 11ch;
  }

  .hero-copy p {
    color: var(--muted);
    max-width: 66ch;
    line-height: 1.7;
    font-size: 0.98rem;
  }

  .hero-footnote {
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.5;
    margin-top: 2px;
  }

  .quick-flow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 4px;
    color: var(--muted);
  }

  .flow-step {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0.55rem 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface-soft) 86%, black);
    font-size: 0.88rem;
    line-height: 1.2;
  }

  .flow-step strong {
    color: var(--text);
  }

  .flow-separator {
    color: var(--accent);
    font-weight: 700;
    opacity: 0.85;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .metric {
    padding: 14px 15px;
    border-radius: 16px;
    background: color-mix(in srgb, var(--surface-soft) 88%, black);
    border: 1px solid var(--border);
    display: grid;
    gap: 4px;
  }

  .metric-label {
    color: var(--muted);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
  }

  .metric-value {
    font-size: 1.35rem;
    font-family: 'IBM Plex Mono', monospace;
    line-height: 1;
    font-weight: 800;
  }

  .metric-note {
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.45;
  }

  .metric.accent {
    background: linear-gradient(135deg, rgba(99, 68, 173, 0.11), rgba(99, 68, 173, 0.03));
    border-color: rgba(99, 68, 173, 0.18);
  }

  .metric.success {
    background: linear-gradient(135deg, rgba(102, 67, 181, 0.10), rgba(102, 67, 181, 0.03));
    border-color: rgba(102, 67, 181, 0.20);
  }

  .metric.warning {
    background: linear-gradient(135deg, rgba(121, 35, 105, 0.08), rgba(121, 35, 105, 0.02));
    border-color: rgba(121, 35, 105, 0.14);
  }

  .metric.subtle {
    background: color-mix(in srgb, var(--surface-soft) 88%, black);
  }

  .controls {
    position: sticky;
    top: 12px;
    z-index: 20;
    padding: 14px;
    backdrop-filter: blur(14px);
  }

  .controls-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    gap: 12px;
    margin-bottom: 12px;
  }

  .field {
    display: grid;
    gap: 8px;
  }

  .field-label {
    font-size: 0.74rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 700;
  }

  .field-control {
    width: 100%;
    padding: 0.92rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-soft);
    color: var(--text);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .field-control:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 4px rgba(99, 68, 173, 0.18);
  }

  .controls-hint {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .table-panel {
    padding: 16px;
  }

  .table-panel__head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    margin-bottom: 14px;
  }

  .table-panel__title {
    font-size: 1.7rem;
  }

  .table-panel__subtitle {
    margin-top: 6px;
    color: var(--muted);
    line-height: 1.6;
    max-width: 70ch;
  }

  .table-panel__meta {
    text-align: right;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .table-wrap {
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    background: var(--surface);
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  thead th {
    position: sticky;
    top: 0;
    z-index: 1;
    text-align: left;
    background: var(--surface-soft);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.72rem;
    padding: 14px 16px;
    border-bottom: 1px solid var(--border);
  }

  tbody tr {
    transition: background 0.18s ease;
  }

  tbody tr:hover {
    background: rgba(99, 68, 173, 0.04);
  }

  td {
    padding: 16px;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
    font-size: 0.92rem;
  }

  .empty-state {
    padding: 42px 24px;
    text-align: center;
    color: var(--muted);
  }

  .empty-state h3 {
    margin-top: 8px;
    font-size: 1.2rem;
  }

  .empty-state p {
    margin-top: 6px;
    line-height: 1.55;
  }

  .disclaimer {
    padding: 16px 18px;
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--surface) 82%, black);
    border: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.84rem;
    line-height: 1.7;
  }

  .disclaimer strong {
    color: var(--text);
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }

  @media (max-width: 1080px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .controls-grid {
      grid-template-columns: 1fr;
    }

  }

  @media (max-width: 860px) {
    .app-shell {
      width: min(100% - 18px, 1520px);
      padding-top: 12px;
    }

    .hero,
    .controls,
    .table-panel {
      border-radius: 20px;
    }

    .hero-stats {
      grid-template-columns: 1fr 1fr;
    }

    .table-panel__head {
      flex-direction: column;
      align-items: start;
    }

    .table-panel__meta {
      text-align: left;
    }
  }

  @media (max-width: 720px) {
    thead {
      display: none;
    }

    table,
    tbody,
    tr,
    td {
      display: block;
      width: 100%;
    }

    tbody tr {
      border-bottom: 1px solid var(--border);
    }

    td {
      display: flex;
      justify-content: space-between;
      gap: 14px;
      padding: 12px 14px;
      border-bottom: 0;
    }

    td + td {
      border-top: 1px solid var(--border);
    }

    td::before {
      content: attr(data-label);
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: 0.7rem;
      font-weight: 700;
      flex: 0 0 42%;
    }

    .hero-stats {
      grid-template-columns: 1fr;
    }

  }
</style>
