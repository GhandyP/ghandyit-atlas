---
interface Props {
  assetCount: number;
  totalMarketCap: string;
  topMarketCapLabel: string;
  totalHolders: string;
  zeroMarketCapCount: number;
}

const { assetCount, totalMarketCap, topMarketCapLabel, totalHolders, zeroMarketCapCount } = Astro.props;
---

<section class="hero">
  <div class="hero-copy">
    <div class="brand-lockup">
      <span class="brand-logo brand-fallback" aria-hidden="true">G</span>
    </div>
    <div class="hero-copy-text">
      <div class="brand-line"><span></span><strong>Ghandyit</strong> · Ondo tokenized assets</div>
      <p class="eyebrow">Market intelligence</p>
      <h1>Analiza el universo tokenizado de Ondo.</h1>
      <p>
        El snapshot sale de <strong>ontonew.md</strong>: compara market cap, holders y contratos sin perderte en ruido.
      </p>

      <div class="quick-flow" aria-label="Flujo de uso rápido">
        <span class="flow-step"><strong>1.</strong> Busca activo</span>
        <span class="flow-separator">→</span>
        <span class="flow-step"><strong>2.</strong> Ordena datos</span>
        <span class="flow-separator">→</span>
        <span class="flow-step"><strong>3.</strong> Abre el contrato</span>
      </div>
    </div>
  </div>

  <div class="hero-stats" aria-label="Resumen rápido">
    <div class="metric accent">
      <span class="metric-label">Activos</span>
      <span class="metric-value">{assetCount}</span>
      <span class="metric-note">Filas de la fuente local.</span>
    </div>

    <div class="metric success">
      <span class="metric-label">Market cap total</span>
      <span class="metric-value">{totalMarketCap}</span>
      <span class="metric-note">{topMarketCapLabel} · fuente local</span>
    </div>

    <div class="metric warning">
      <span class="metric-label">Holders totales</span>
      <span class="metric-value">{totalHolders}</span>
      <span class="metric-note">Suma de holders publicados.</span>
    </div>

    <div class="metric">
      <span class="metric-label">Market cap en cero</span>
      <span class="metric-value">{zeroMarketCapCount}</span>
      <span class="metric-note">Solo ceros explícitos; N/D queda separado.</span>
    </div>
  </div>

  <p class="hero-footnote">Fuente: ontonew.md · as-of desconocido · {assetCount} filas cargadas.</p>
</section>

<style>
  .brand-fallback {
    display: grid;
    place-items: center;
    color: var(--bg);
    background: linear-gradient(135deg, var(--accent), var(--success));
    font-family: 'IBM Plex Mono', monospace;
    font-size: 1.15rem;
    font-weight: 800;
  }

  .controls-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 12px;
  }

  .filter-reset {
    flex: 0 0 auto;
    padding: 0.6rem 0.85rem;
    color: var(--text);
    background: var(--surface-soft);
    border: 1px solid var(--border);
    border-radius: 10px;
    font: inherit;
    font-size: 0.84rem;
    font-weight: 700;
  }

  .filter-reset:hover,
  .filter-reset:focus-visible {
    border-color: var(--accent);
  }

  .filter-reset:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  @media (max-width: 640px) {
    .controls-actions {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>

<section class="controls" aria-label="Filtros y ordenación">
  <div class="controls-grid">
    <label class="field">
      <span class="field-label">Buscar activo</span>
      <input class="field-control" type="search" id="searchInput" placeholder="Token, símbolo, contrato o website" autocomplete="off" />
    </label>

    <label class="field">
      <span class="field-label">Ordenar lista</span>
      <select class="field-control" id="sortSelect">
        <option value="rank-asc" selected>Ranking · ascendente</option>
        <option value="market-desc">Market cap · mayor a menor</option>
        <option value="market-asc">Market cap · menor a mayor</option>
        <option value="holders-desc">Holders · mayor a menor</option>
        <option value="holders-asc">Holders · menor a mayor</option>
        <option value="name-asc">Token · A a Z</option>
        <option value="symbol-asc">Símbolo · A a Z</option>
      </select>
    </label>

    <label class="field">
      <span class="field-label">Calidad de fila</span>
      <select class="field-control" id="qualitySelect">
        <option value="all" selected>Todas las filas</option>
        <option value="unresolved-identity">Identidad sin resolver</option>
        <option value="display-duplicate">Display duplicado</option>
        <option value="partial">Fila parcial</option>
        <option value="missing-numeric">Campo numérico ausente</option>
        <option value="malformed-numeric">Campo numérico malformado</option>
        <option value="invalid-row">Fila inválida</option>
      </select>
    </label>
  </div>

  <div class="controls-actions">
    <button class="filter-reset" type="button" id="resetCatalogFilters">Limpiar filtros</button>
    <p class="controls-hint">Busca por token, símbolo o contrato. La calidad y el orden se aplican a toda la lista visible.</p>
  </div>
</section>
