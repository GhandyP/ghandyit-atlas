---
interface EtfRow {
  ticker: string;
  name: string;
  return5y: number | null;
  ter: number;
  risk: string;
  info: string;
  blockId: string;
  blockName: string;
  blockColor: string;
  blockSoft: string;
}

interface BlockSummary {
  id: string;
  name: string;
  color: string;
  brandColor: string;
  brandSoft: string;
  description: string;
  etfs: EtfRow[];
  bestReturn: number | null;
  bestTicker: string;
  cheapestTer: number | null;
  ndCount: number;
  averageReturn: number | null;
}

interface Props {
  blocks: BlockSummary[];
  rows: EtfRow[];
}

const { blocks, rows } = Astro.props;

const riskRank: Record<string, number> = {
  bajo: 1,
  'bajo-medio': 2,
  'medio-bajo': 2,
  medio: 3,
  'medio-alto': 4,
  'alto-medio': 4,
  alto: 5,
};

const totalVisible = rows.length;
---

<section class="table-panel">
  <div class="table-panel__head">
    <div>
      <h2 class="table-panel__title">Explora por bloque</h2>
      <p class="table-panel__subtitle">
        Empieza por un tema, abre solo lo necesario y compara rentabilidad, coste y riesgo con claridad. El orden organiza cada bloque, no todo el universo en una sola lista.
      </p>
    </div>

    <div class="table-panel__meta" id="resultSummary">
      Mostrando {totalVisible} ETFs · Orden por defecto dentro de cada bloque: rentabilidad 5Y
    </div>
  </div>

  <div class="block-grid" aria-label="Bloques temáticos">
    <button class="block-card active" type="button" data-block="all" data-block-label="Todos los bloques" style="--block-color: #6344ad; --block-soft: rgba(99, 68, 173, 0.10)">
      <span class="block-card__top">
        <span class="block-card__label">Todos los bloques</span>
        <span class="block-card__count">{totalVisible} ETFs</span>
      </span>
      <span class="block-card__big">Vista completa</span>
      <span class="block-card__small">Vuelve al mapa general y compara todo el universo.</span>
    </button>

    {blocks.map((block) => (
      <button class="block-card" type="button" data-block={block.id} data-block-label={block.name} style={`--block-color: ${block.brandColor}; --block-soft: ${block.brandSoft}`}> 
        <span class="block-card__top">
          <span class="block-card__label">{block.name}</span>
          <span class="block-card__count">{block.etfs.length} ETFs</span>
        </span>
        <span class="block-card__big">{block.bestTicker} · {block.bestReturn === null ? 'N/D' : `+${block.bestReturn.toFixed(1)}%`}</span>
        <span class="block-card__small">Más barato: {block.cheapestTer === null ? 'N/D' : `${block.cheapestTer.toFixed(2)}% TER`}</span>
      </button>
    ))}
  </div>

  <div class="accordion" data-accordion>
    {blocks.map((block, index) => {
      const blockRows = block.etfs;
      const averageTer = blockRows.length ? blockRows.reduce((sum, etf) => sum + etf.ter, 0) / blockRows.length : null;
      const cheapest = [...blockRows].sort((a, b) => a.ter - b.ter)[0];

      return (
        <details class="block-group" data-block-id={block.id} open={index === 0}>
          <summary class="block-summary">
            <div class="block-summary__copy">
              <div class="block-summary__titleline" style={`--block-color: ${block.brandColor}`}>
                <span class="block-summary__marker"></span>
                <h3 class="block-summary__title">{block.name}</h3>
              </div>
              <p>{block.description}</p>
            </div>

            <div class="block-summary__stats">
              <span class="mini-stat">
                <strong>{block.etfs.length}</strong>
                <span>ETFs</span>
              </span>
              <span class="mini-stat">
                <strong>{block.bestReturn === null ? 'N/D' : `+${block.bestReturn.toFixed(1)}%`}</strong>
                <span>mejor 5Y</span>
              </span>
              <span class="mini-stat">
                <strong>{averageTer === null ? 'N/D' : `${averageTer.toFixed(2)}%`}</strong>
                <span>TER medio</span>
              </span>
              <span class="mini-stat">
                <strong>{block.ndCount}</strong>
                <span>N/D</span>
              </span>
            </div>
          </summary>

          <div class="block-body">
            <div class="block-body__topline">
              <span>Más fuerte: {block.bestTicker} · {block.bestReturn === null ? 'N/D' : `+${block.bestReturn.toFixed(1)}%`}</span>
              <span>Más barato: {cheapest ? `${cheapest.ticker} · ${cheapest.ter.toFixed(2)}% TER` : 'N/D'}</span>
            </div>

            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>ETF</th>
                    <th>Bloque</th>
                    <th>5Y</th>
                    <th>TER</th>
                    <th>Riesgo</th>
                    <th>Qué hace</th>
                  </tr>
                </thead>
                <tbody data-etf-tbody data-block-id={block.id}>
                  {blockRows.map((etf) => {
                    const returnClass = etf.return5y === null ? 'nd' : etf.return5y >= 0 ? 'positive' : 'negative';
                    const returnDisplay = etf.return5y === null ? 'N/D' : `${etf.return5y >= 0 ? '+' : ''}${etf.return5y.toFixed(1)}%`;
                    const riskClass = etf.risk;
                    const riskLabel = etf.risk.replace(/-/g, ' ');

                    return (
                      <tr
                        data-block-id={etf.blockId}
                        data-ticker={etf.ticker.toLowerCase()}
                        data-name={etf.name.toLowerCase()}
                        data-block-name={etf.blockName.toLowerCase()}
                        data-return-value={etf.return5y === null ? '' : String(etf.return5y)}
                        data-ter-value={String(etf.ter)}
                        data-risk-value={String(riskRank[etf.risk] ?? 99)}
                      >
                        <td data-label="ETF">
                          <div class="etf-main">
                            <span class="etf-ticker">{etf.ticker}</span>
                            <span class="etf-name">{etf.name}</span>
                          </div>
                        </td>

                        <td data-label="Bloque">
                          <span class="block-pill" title={etf.blockName} style={`--block-color: ${etf.blockColor}; --block-soft: ${etf.blockSoft};`}>
                            <span class="block-dot"></span>
                            {etf.blockName}
                          </span>
                        </td>

                        <td data-label="5Y">
                          <span class={`return-value ${returnClass}`}>{returnDisplay}</span>
                        </td>

                        <td data-label="TER">
                          <span class="ter-value">{etf.ter.toFixed(2)}%</span>
                        </td>

                        <td data-label="Riesgo">
                          <span class={`risk-pill ${riskClass}`}>{riskLabel}</span>
                        </td>

                        <td data-label="Qué hace">
                          <span class="explain">{etf.info}</span>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </div>
        </details>
      );
    })}
  </div>

  <div class="empty-state" id="emptyState" hidden>
    <h3>No hay resultados</h3>
    <p>Prueba con otro ticker, otro bloque o un orden distinto.</p>
  </div>

  <div class="disclaimer">
    <strong>Aviso legal:</strong> este panel es informativo y educativo. No es asesoramiento financiero ni una recomendación de compra o venta. Las rentabilidades pasadas no garantizan resultados futuros.
  </div>
</section>

<script define:vars={{ initialBlocks: blocks }}>
  const state = {
    activeBlock: 'all',
    searchTerm: '',
    sortKey: 'return-desc',
  };

  const resultSummary = document.getElementById('resultSummary');
  const emptyState = document.getElementById('emptyState');
  const searchInput = document.getElementById('searchInput');
  const sortSelect = document.getElementById('sortSelect');
  const blockCards = Array.from(document.querySelectorAll('.block-card[data-block]'));
  const groups = Array.from(document.querySelectorAll('.block-group[data-block-id]'));

  const totalRows = initialBlocks.reduce((sum, block) => sum + block.etfs.length, 0);

  function normalise(text) {
    return (text || '').toString().trim().toLowerCase();
  }

  function getNumeric(value) {
    if (value === '' || value === null || value === undefined) return null;
    const parsed = Number.parseFloat(String(value));
    return Number.isNaN(parsed) ? null : parsed;
  }

  function compareRows(a, b) {
    const sortKey = state.sortKey;

    if (sortKey === 'ticker-asc') {
      return a.dataset.ticker.localeCompare(b.dataset.ticker);
    }

    if (sortKey.startsWith('return')) {
      const aVal = getNumeric(a.dataset.returnValue);
      const bVal = getNumeric(b.dataset.returnValue);
      const asc = sortKey === 'return-asc';

      if (aVal === null && bVal === null) return 0;
      if (aVal === null) return asc ? -1 : 1;
      if (bVal === null) return asc ? 1 : -1;
      return asc ? aVal - bVal : bVal - aVal;
    }

    if (sortKey.startsWith('ter')) {
      const aVal = getNumeric(a.dataset.terValue);
      const bVal = getNumeric(b.dataset.terValue);
      const asc = sortKey === 'ter-asc';

      if (aVal === null && bVal === null) return 0;
      if (aVal === null) return asc ? -1 : 1;
      if (bVal === null) return asc ? 1 : -1;
      return asc ? aVal - bVal : bVal - aVal;
    }

    if (sortKey.startsWith('risk')) {
      const aVal = getNumeric(a.dataset.riskValue) ?? 99;
      const bVal = getNumeric(b.dataset.riskValue) ?? 99;
      const asc = sortKey === 'risk-asc';
      return asc ? aVal - bVal : bVal - aVal;
    }

    return 0;
  }

  function matchesFilters(row) {
    const blockMatch = state.activeBlock === 'all' || row.dataset.blockId === state.activeBlock;
    if (!state.searchTerm) return blockMatch;

    const haystack = [row.dataset.ticker, row.dataset.name, row.dataset.blockName].map(normalise).join(' ');
    return blockMatch && haystack.includes(state.searchTerm);
  }

  function updateActiveCards() {
    blockCards.forEach((card) => {
      const isActive = card.dataset.block === state.activeBlock;
      card.classList.toggle('active', isActive);
      card.setAttribute('aria-pressed', String(isActive));
    });
  }

  function updateSummary(visibleCount, visibleGroups) {
    if (!resultSummary) return;
    const blockLabel = state.activeBlock === 'all'
      ? 'Todos los bloques'
      : (blockCards.find((card) => card.dataset.block === state.activeBlock)?.dataset.blockLabel || 'Bloque seleccionado');

    const sortLabel = sortSelect?.selectedOptions[0]?.textContent ?? '';
    resultSummary.textContent = `Mostrando ${visibleCount} de ${totalRows} ETFs · ${visibleGroups} bloques · ${blockLabel} · Orden dentro de bloque: ${sortLabel}`;
  }

  function render() {
    let visibleCount = 0;
    let visibleGroups = 0;

    groups.forEach((group) => {
      const blockId = group.dataset.blockId;
      const rows = Array.from(group.querySelectorAll('tbody tr'));
      rows.sort(compareRows);

      rows.forEach((row) => {
        group.querySelector('tbody').appendChild(row);
      });

      const visibleRows = rows.filter(matchesFilters);
      const shouldShowGroup = state.activeBlock === 'all'
        ? visibleRows.length > 0
        : blockId === state.activeBlock && visibleRows.length > 0;

      group.hidden = !shouldShowGroup;
      group.open = shouldShowGroup && (state.searchTerm.length > 0 || state.activeBlock !== 'all' || blockId === initialBlocks[0]?.id);

      rows.forEach((row) => {
        const visible = matchesFilters(row);
        row.hidden = !visible;
        if (visible) visibleCount += 1;
      });

      if (shouldShowGroup) visibleGroups += 1;
    });

    emptyState.hidden = visibleCount !== 0;
    updateSummary(visibleCount, visibleGroups);
  }

  document.addEventListener('DOMContentLoaded', () => {
    updateActiveCards();
    render();

    searchInput?.addEventListener('input', (event) => {
      state.searchTerm = normalise(event.target.value);
      render();
    });

    sortSelect?.addEventListener('change', (event) => {
      state.sortKey = event.target.value;
      render();
    });

    blockCards.forEach((card) => {
      card.addEventListener('click', () => {
        state.activeBlock = card.dataset.block ?? 'all';
        updateActiveCards();
        render();

        const target = document.querySelector(`.block-group[data-block-id="${state.activeBlock}"]`);
        target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
  });
</script>
