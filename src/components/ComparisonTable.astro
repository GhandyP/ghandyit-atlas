---
interface Props { cohort: string; snapshotId: string; rows: any[] }
const { cohort, snapshotId, rows } = Astro.props;
const show = (item: any, label = 'Derivado') => { const value = item?.value ?? item; const missing = value === null || value === undefined || value === ''; return { value: missing ? `N/D${item?.reason ? ` — ${item.reason}` : ' — sin fuente verificada'}` : String(value), label: item?.status === 'observed' ? 'Observado' : label }; };
const cell = (item: any, label = 'Derivado') => show(item, label);
---
<section class="comparison" data-comparison-scope={cohort} aria-labelledby="comparison-title">
  <div class="comparison__head"><div><p class="eyebrow">Comparación compatible</p><h2 id="comparison-title">{cohort}</h2><p>Alcance: una cohorte y un snapshot ({snapshotId}). Observado = catálogo; Derivado = cálculo con semántica validada. No hay ranking global ni llamadas a proveedores.</p></div></div>
  <div class="comparison__scroll"><table><thead><tr><th>Activo</th><th>Catálogo</th><th>1a total return</th><th>5a CAGR</th><th>Revenue growth</th><th>EPS growth</th><th>Quality</th><th>Value</th><th>Momentum 1m / 3m / 12m</th><th>Risk vol. / drawdown</th><th>Liquidity token / underlying</th></tr></thead><tbody>
    {rows.map((row) => { const one = cell(row.returns?.oneYear ?? row.oneYear), five = cell(row.returns?.fiveYear ?? row.fiveYear), revenue = cell(row.fundamentals?.revenueGrowth ?? row.revenueGrowth), eps = cell(row.fundamentals?.epsGrowth ?? row.epsGrowth), quality = cell(row.quality), value = cell(row.value), m = row.momentum ?? {}, risk = row.risk ?? {}, liq = row.liquidity ?? {}; return <tr><th scope="row">{row.name ?? 'N/D'} <small>{row.symbol ?? 'N/D'}</small></th><td>{cell(row.observed?.marketCap, 'Observado').value}<small>Market cap · {cell(row.observed?.holders, 'Observado').value} holders</small></td><td>{one.value}<small>{one.label}</small></td><td>{five.value}<small>{five.label}</small></td><td>{revenue.value}<small>{revenue.label}</small></td><td>{eps.value}<small>{eps.label}</small></td><td>{quality.value}<small>{quality.label}</small></td><td>{value.value}<small>{value.label}</small></td><td>{cell(m['1m']).value} / {cell(m['3m']).value} / {cell(m['12m']).value}<small>Derivado</small></td><td>{cell(risk.volatility).value} / {cell(risk.maxDrawdown).value}<small>Derivado</small></td><td>{cell(liq.token).value} / {cell(liq.underlying).value}<small>Derivado</small></td></tr>; })}
  </tbody></table></div>
</section>
<style>.comparison{display:grid;gap:10px;padding:18px;background:var(--surface);border:1px solid var(--border);border-radius:20px}.comparison p{color:var(--muted);line-height:1.5}.comparison__scroll{overflow:auto}.comparison table{width:100%;min-width:1050px;border-collapse:collapse}.comparison th,.comparison td{padding:9px;border-bottom:1px solid var(--border);text-align:left;vertical-align:top}.comparison small{display:block;color:var(--muted);font-size:.72rem;margin-top:4px}</style>
